# Copy to .env at repo root. Values come from Supabase: Project Settings → API.

# Project URL (Settings → API → Project URL)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Legacy: anon public JWT — browser / Vite (Settings → API → anon public)
SUPABASE_ANON_KEY=

# New keys (optional; use if your dashboard shows sb_publishable / sb_secret instead of anon JWT)
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# service_role — backend only, never expose in frontend (Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY=

# Optional legacy; this API validates sessions only via GET /auth/v1/user + SUPABASE_ANON_KEY.
SUPABASE_JWT_SECRET=

# AI (optional; extraction falls back to a stub without a key)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8001

# Optional overrides (otherwise SUPABASE_* above is reused for the UI)
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
VITE_API_PREFIX=/api

USE_VISION_OCR=false
ENABLE_BATCH=true
GEMINI_API_KEY=
